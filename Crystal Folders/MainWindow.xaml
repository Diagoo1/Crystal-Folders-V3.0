<Window x:Class="CrystalFolders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CrystalFolders"
        Title="{DynamicResource AppTitle}" Height="740" Width="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseDown="Window_MouseDown" Loaded="Window_Loaded"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI">

    <Window.Resources>
        <local:PathToIconConverter x:Key="PathToIconConverter"/>

        <!-- ================== TOOLTIP STYLES ================== -->
        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Placement" Value="MousePoint"/>
            <Setter Property="VerticalOffset" Value="15"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource DynamicCardBg}" 
                                BorderBrush="{DynamicResource DynamicBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,8"
                                Margin="0,0,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="{DynamicResource DynamicMainText}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" 
                                       MaxWidth="350"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== SCROLLBAR STYLES ================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" Cursor="Hand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRect"
                                                        Background="{StaticResource AccentGradient}"
                                                        CornerRadius="4"
                                                        Margin="2,0,2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="{DynamicResource DynamicBlueMedium}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRect" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                                        <Setter TargetName="ThumbRect" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" Cursor="Hand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================== MAIN WINDOW STRUCTURE ================== -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="16"
            BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================== HEADER SECTION ================== -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,0,0,1" Background="{DynamicResource DynamicCardBg}"
                    CornerRadius="16,16,0,0">
                <Grid Margin="20,0">

                    <!-- Logo & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3" Color="#0EA5E9"/>
                            </Border.Effect>
                            <Image Source="pack://application:,,,/Assets/Logo.png" Width="30" Height="30" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="{DynamicResource AppTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="AboutBtn" Style="{StaticResource IconButton}" Click="About_Click"
                                ToolTip="{DynamicResource AboutApp}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="ThemeToggle_Click"
                                ToolTip="{DynamicResource Theme}" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock x:Name="SunIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Visibility="Visible"/>
                                <TextBlock x:Name="MoonIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Settings_Click"
                                ToolTip="{DynamicResource Settings}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{DynamicResource DynamicBorderBrush}" Margin="4,0,12,0"/>
                        <Button Style="{StaticResource IconButton}" Click="Exit_Click" ToolTip="{DynamicResource Close}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================== MAIN CONTENT ================== -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================== LEFT PANEL ================== -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Folders List Card -->
                    <Border Grid.Row="0" Style="{StaticResource StaticCard}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconBox}" Background="#150EA5E9">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource DynamicAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{DynamicResource ManageFolders}" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicMainText}"
                                           VerticalAlignment="Center" FontSize="14"
                                           Margin="12,0,0,0"/>

                                <!-- Clear Cache Button -->
                                <Button x:Name="ClearCacheBtn" Grid.Column="2" Click="ClearCacheBtn_Click"
                                        ToolTip="{DynamicResource ClearCache}" VerticalAlignment="Center"
                                        Width="32" Height="32">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#15EF4444"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#30EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE117;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </Grid>

                            <!-- Drag & Drop Area -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Border BorderBrush="{DynamicResource DynamicBorderBrush}"
                                        BorderThickness="1.5" CornerRadius="10" Background="Transparent"
                                        AllowDrop="True" Drop="DropList_Drop" DragEnter="DropList_DragEnter">
                                    <Grid>
                                        <Border Background="{DynamicResource DynamicHoverBg}" Opacity="0.2" CornerRadius="8.5"/>

                                        <!-- Placeholder -->
                                        <StackPanel x:Name="DropPlaceholder"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=DropList, Path=HasItems}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                                       Foreground="{DynamicResource DynamicSubText}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.5"/>
                                            <TextBlock Text="{DynamicResource DragHere}" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource DragHereSub}" FontSize="11"
                                                       Foreground="{DynamicResource DynamicSubText}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.6"/>
                                        </StackPanel>

                                        <!-- Folders List -->
                                        <ListBox x:Name="DropList" SelectionMode="Extended"
                                                 Background="Transparent" BorderThickness="0" Padding="6"
                                                 Cursor="Arrow"
                                                 SelectionChanged="DropList_SelectionChanged">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,4">
                                                        <Image Source="{Binding Converter={StaticResource PathToIconConverter}}"
                                                               Width="24" Height="24" Margin="0,0,12,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource DynamicMainText}"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Grid>
                                                                    <Border x:Name="Bd" Background="Transparent"
                                                                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                                                                        <Grid>
                                                                            <Border x:Name="BgEffect" Background="{DynamicResource DynamicHoverBg}"
                                                                                    CornerRadius="7" Opacity="0" IsHitTestVisible="False"/>
                                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                              Margin="{TemplateBinding Padding}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <Border x:Name="Indicator" Width="4" Height="20" CornerRadius="2"
                                                                            Background="{DynamicResource DynamicAccent}"
                                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                            Margin="0,0,0,0" Opacity="0"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BgEffect" Property="Opacity" Value="0.4"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="BgEffect" Property="Opacity" Value="0.8"/>
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                                                        <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Action Buttons Row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Remove Button -->
                                <Button x:Name="Remove" Grid.Column="0" Margin="0,0,10,0" Click="Remove_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#15EF4444"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Height" Value="42"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#30EF4444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Remove}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Remove All Button -->
                                <Button x:Name="Remove_All" Grid.Column="1" Margin="0,0,10,0" Click="RemoveAll_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#15F97316"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Height" Value="42"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#30F97316"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicInfo}"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource RemoveAll}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Browse Button -->
                                <Button x:Name="BrowseBtn" Grid.Column="2" Click="BrowseBtn_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#150EA5E9"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Height" Value="42"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#300EA5E9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Browse}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Stats Cards -->
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                        <!-- Folders Stats Card -->
                        <Border Style="{StaticResource StaticCard}" Margin="0,0,8,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="#15F97316" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="#F97316" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Folders}" FontSize="11"
                                               Foreground="{DynamicResource DynamicSubText}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="Dot" Text="0" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource DynamicMainText}" LineHeight="22"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Subfolders Stats Card -->
                        <Border Style="{StaticResource StaticCard}" Margin="8,0,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="#1522C55E" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE169;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource SubFolders}" FontSize="11"
                                               Foreground="{DynamicResource DynamicSubText}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="Dotsub" Text="0" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource DynamicMainText}" LineHeight="22"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- ================== RIGHT PANEL ================== -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon Preview Card -->
                    <Border Grid.Row="0" Style="{StaticResource StaticCard}">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Style="{StaticResource IconBox}" Background="#15D946EF">
                                        <TextBlock Text="&#xEC7F;" FontFamily="Segoe MDL2 Assets" Foreground="#D946EF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource IconPreview}" FontWeight="Bold"
                                               Foreground="{DynamicResource DynamicMainText}"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                                <Button x:Name="OpenConverter" Click="OpenConverter_Click"
                                        ToolTip="{DynamicResource IconConverter}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="32" Height="32">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#156366F1"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#306366F1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicIndigo}"/>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </Grid>

                            <!-- Preview Area -->
                            <Border x:Name="IconPreviewArea" Height="190" Background="Transparent"
                                    CornerRadius="10" BorderBrush="{DynamicResource DynamicBorderBrush}"
                                    BorderThickness="1" MouseLeftButtonDown="IconPreviewArea_MouseLeftButtonDown"
                                    Cursor="Arrow">
                                <Grid>
                                    <Rectangle Fill="{DynamicResource DynamicHoverBg}" Opacity="0.3" RadiusX="9" RadiusY="9"/>

                                    <Rectangle x:Name="Icon_border" StrokeThickness="1.5"
                                               StrokeDashArray="6 6" RadiusX="10" RadiusY="10" Margin="14">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Stroke" Value="{DynamicResource DynamicSubText}"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=IconPreviewArea}" Value="True">
                                                        <Setter Property="Stroke" Value="{DynamicResource DynamicAccent}"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- No Icon Selected -->
                                    <Border Background="Transparent" CornerRadius="10"
                                            Cursor="Hand" MouseLeftButtonDown="IconPreviewArea_MouseLeftButtonDown">
                                        <StackPanel x:Name="Icon_cross" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                                       Foreground="{DynamicResource DynamicSubText}"
                                                       HorizontalAlignment="Center" Opacity="0.4"/>
                                            <TextBlock Text="{DynamicResource ChooseIcon}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Icon Image -->
                                    <Image x:Name="Iconpic" Width="90" Height="90" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Cursor="Hand" MouseLeftButtonDown="IconPreviewArea_MouseLeftButtonDown">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.25"/>
                                        </Image.Effect>
                                    </Image>

                                    <!-- Restore Icon -->
                                    <TextBlock x:Name="Icon_restore" Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="40" Foreground="{DynamicResource DynamicAccent}"
                                               Opacity="0.3" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Type Tag -->
                                    <Border x:Name="TypeTag" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="10" CornerRadius="6" Padding="8,4"
                                            Visibility="Collapsed" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TypeTagIcon" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TypeTagText" FontSize="10" FontWeight="Bold"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Icon Action Buttons -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Choose Icon Button -->
                                <Button x:Name="ChooseBtn" Grid.Column="0" Height="38" Margin="0,0,8,0" Click="ChooseBtn_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#15D946EF"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#30D946EF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="#D946EF"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource ChooseIcon}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Restore Button -->
                                <Button x:Name="RestoreBtn" Grid.Column="1" Height="38" Margin="8,0,0,0" Click="RestoreBtn_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#156366F1"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#306366F1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource DynamicIndigo}"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="RestoreIcon" Text="&#xE777;" 
                                                   FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="RestoreText" Text="{DynamicResource Restore}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Settings Card -->
                    <Border Grid.Row="1" Style="{StaticResource StaticCard}" Margin="0,20,0,0">
                        <StackPanel>
                            <!-- Card Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource IconBox}" Background="#156366F1">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#6366F1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings}" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicMainText}"
                                           VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>

                            <!-- Include Subfolders Option -->
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource IncludeSubfolders}" FontWeight="SemiBold"
                                               FontSize="12" Foreground="{DynamicResource DynamicMainText}"/>
                                    <TextBlock x:Name="SubFolderDescriptionText" 
                                               Text="{DynamicResource IncludeSubfoldersDesc}" 
                                               FontSize="10"
                                               Foreground="{DynamicResource DynamicSubText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="SlideSub" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ModernSwitch}"
                                              Checked="SlideSub_Checked" Unchecked="SlideSub_Unchecked"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource DynamicBorderBrush}" Margin="0,0,0,16"/>

                            <!-- Portable Mode Option -->
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PortableMode}" FontWeight="SemiBold"
                                                   FontSize="12" Foreground="{DynamicResource DynamicMainText}"/>
                                        <TextBlock Text="{DynamicResource PortableModeDesc}" FontSize="10"
                                                   Foreground="{DynamicResource DynamicSubText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="Help" Style="{StaticResource IconButton}" Click="Help_Click"
                                            Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="{DynamicResource DynamicAccent}"/>
                                    </Button>
                                </StackPanel>
                                <ToggleButton x:Name="SlidePortable" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ModernSwitch}" Click="SlidePortable_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Apply Customization Button -->
                    <Button x:Name="Customize" Grid.Row="3" Style="{StaticResource ModernGradientBtn}"
                            Height="67" Click="Customize_Click" Margin="0,20,0,0">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#0EA5E9"/>
                        </Button.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CustomizeIcon" Text="&#xE790;" 
                                       FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CustomizeText" Text="{DynamicResource ApplyCustomization}" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>