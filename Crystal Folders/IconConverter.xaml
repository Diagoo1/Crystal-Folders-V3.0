<Window x:Class="CrystalFolders.IconConverter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource IconConverterTitle}" 
        Height="620" Width="440" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="{DynamicResource GlobalFontFamily}"
        MouseDown="Window_MouseDown">

    <!-- ================== MAIN WINDOW STRUCTURE ================== -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="16" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================== HEADER SECTION ================== -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DynamicBorderBrush}" 
                    BorderThickness="0,0,0,1" Background="{DynamicResource DynamicCardBg}" 
                    CornerRadius="16,16,0,0">
                <Grid Margin="20,0">
                    <!-- Left Side - Logo and Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#150EA5E9" Margin="0,0,12,0">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                       Foreground="{DynamicResource DynamicAccent}" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource IconConverterTitle}" FontSize="15" FontWeight="Bold" 
                                   Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Side - Close Button -->
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-5,0">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF4444"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ================== MAIN CONTENT SECTION ================== -->
            <StackPanel Grid.Row="1" Margin="25">

                <!-- Step 1 - Image Selection Card -->
                <Border Style="{StaticResource StaticCard}" Padding="18" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Step1SelectImage}" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource DynamicMainText}" Margin="0,0,0,12"/>

                        <!-- Image Preview Area -->
                        <Border Height="140" Background="{DynamicResource DynamicHoverBg}" CornerRadius="10" 
                                BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" Margin="0,0,0,15">
                            <Grid>
                                <StackPanel x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="40" 
                                               Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="{DynamicResource NoImageSelected}" FontSize="12" 
                                               Foreground="{DynamicResource DynamicSubText}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                                    </Image.Effect>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Browse Button -->
                        <Button Height="42" Click="Browse_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#150EA5E9"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#300EA5E9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource BrowseImagesBtn}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Step 2 - Save Location Card -->
                <Border Style="{StaticResource StaticCard}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Step2SaveLocation}" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource DynamicMainText}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Interactive Path Container -->
                            <Border x:Name="PathContainer" Grid.Column="0" CornerRadius="10" BorderThickness="1" Margin="0,0,10,0" 
                                    Cursor="Hand" MouseDown="PathContainer_MouseDown" Background="Transparent"
                                    ToolTipService.InitialShowDelay="300"
                                    ToolTip="{Binding Text, ElementName=SavePathTxt}">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DynamicAccent}"/>
                                                <Setter Property="Background" Value="#0A0EA5E9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Border.Resources>
                                    <Style TargetType="ToolTip">
                                        <Setter Property="HasDropShadow" Value="False"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Placement" Value="MousePoint"/>
                                        <Setter Property="VerticalOffset" Value="15"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToolTip">
                                                    <Border Background="{DynamicResource DynamicCardBg}" 
                                                            BorderBrush="{DynamicResource DynamicBorderBrush}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="8" 
                                                            Padding="12,8"
                                                            Margin="0,0,12,12">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                                                        </Border.Effect>
                                                        <TextBlock Text="{TemplateBinding Content}" 
                                                                   Foreground="{DynamicResource DynamicMainText}" 
                                                                   FontSize="12" 
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" 
                                                                   MaxWidth="350"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Resources>

                                <Grid>
                                    <!-- Display Text -->
                                    <TextBlock x:Name="SavePathTxt" Text="..." Foreground="{DynamicResource DynamicSubText}" 
                                               VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" FontSize="12"/>

                                    <!-- Edit TextBox (Hidden by default) -->
                                    <TextBox x:Name="SavePathInput" Visibility="Collapsed" 
                                             Background="Transparent" BorderThickness="0" 
                                             Foreground="{DynamicResource DynamicMainText}" 
                                             VerticalContentAlignment="Center" Margin="8,0" FontSize="12"
                                             LostFocus="SavePathInput_LostFocus" KeyDown="SavePathInput_KeyDown"/>
                                </Grid>
                            </Border>

                            <!-- Select Path Button -->
                            <Button Grid.Column="1" Height="42" Padding="15,0" Click="SaveLocation_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#156366F1"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DynamicIndigo}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#306366F1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource SelectPathBtn}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Hint for user -->
                        <TextBlock Text="{DynamicResource PathEditHint}" FontSize="10" Foreground="{DynamicResource DynamicSubText}" 
                                   Margin="0,8,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================== FOOTER SECTION ================== -->
            <Border Grid.Row="2" Background="{DynamicResource DynamicCardBg}" CornerRadius="0,0,16,16" 
                    Padding="25,20" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,1,0,0">

                <!-- Convert Button -->
                <Button Style="{StaticResource ModernGradientBtn}" Height="48" Click="Convert_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#0EA5E9"/>
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource ConvertAndSaveBtn}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>