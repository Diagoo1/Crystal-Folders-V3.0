<Window x:Class="CrystalFolders.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutApp}" 
        Height="585" Width="450" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="{DynamicResource AppFlowDirection}" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ================== TOOLTIP STYLES ================== -->
        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Placement" Value="MousePoint"/>
            <Setter Property="VerticalOffset" Value="12"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource DynamicCardBg}" 
                                BorderBrush="{DynamicResource DynamicBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,8"
                                Margin="0,0,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock Text="{TemplateBinding Content}" 
                                       Foreground="{DynamicResource DynamicMainText}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" 
                                       MaxWidth="300"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== BUTTON STYLES ================== -->
        <!-- Close Button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link Button -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Circle -->
        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Modern Button -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ================== MAIN WINDOW STRUCTURE ================== -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="16" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1.5" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================== HEADER SECTION ================== -->
            <Grid Grid.Row="0" Height="50" Margin="15,10,15,5">
                <!-- Left Side - MacOS Dots -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FF5F57" Margin="0,0,8,0"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FEBC2E" Margin="0,0,8,0"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#28C840"/>
                </StackPanel>
                <!-- Right Side - Close Button -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnClose" Content="&#xE8BB;" 
                            Style="{StaticResource CloseButton}" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================== MAIN CONTENT SECTION ================== -->
            <StackPanel Grid.Row="1" Margin="25,5,25,15">

                <!-- Logo & App Name -->
                <StackPanel HorizontalAlignment="Center" Margin="0,5,0,10">
                    <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3" Color="#0EA5E9"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/Logo.png" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" Foreground="{DynamicResource DynamicMainText}" Margin="0,15,0,0"/>
                    <Border Background="#100EA5E9" Padding="8,3" CornerRadius="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource VersionBuild}" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource DynamicAccent}"/>
                    </Border>
                </StackPanel>

                <!-- Description Card -->
                <Border Background="{DynamicResource DynamicCardBg}" CornerRadius="10" 
                        BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" 
                        Padding="15,12" Margin="0,5,0,10">
                    <TextBlock Text="{DynamicResource ProfessionalSolution}" TextWrapping="Wrap" 
                               TextAlignment="Center" FontSize="12" LineHeight="20" 
                               Foreground="{DynamicResource DynamicSubText}"/>
                </Border>

                <!-- Quick Links Section -->
                <Border Background="{DynamicResource DynamicCardBg}" CornerRadius="10" 
                        BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" 
                        Padding="12,10" Margin="0,0,0,10">
                    <UniformGrid Columns="3" Rows="1" FlowDirection="LeftToRight">
                        <!-- Website Button -->
                        <Button Click="btnWebsite_Click" Style="{StaticResource LinkBtn}" ToolTip="{DynamicResource Website}">
                            <StackPanel>
                                <Border Style="{StaticResource IconCircle}" Background="#150EA5E9" Margin="0,0,0,5">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="{DynamicResource DynamicAccent}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Website}" FontSize="11" FontWeight="Bold" 
                                           Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Donate Button -->
                        <Button Click="btnPayPal_Click" Style="{StaticResource LinkBtn}" ToolTip="{DynamicResource Donate}">
                            <StackPanel>
                                <Border Style="{StaticResource IconCircle}" Background="#1522C55E" Margin="0,0,0,5">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="{DynamicResource DynamicSuccess}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Donate}" FontSize="11" FontWeight="Bold" 
                                           Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Email Button -->
                        <Button Click="btnEmail_Click" Style="{StaticResource LinkBtn}" ToolTip="{DynamicResource Email}">
                            <StackPanel>
                                <Border Style="{StaticResource IconCircle}" Background="#15EF4444" Margin="0,0,0,5">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                               Foreground="{DynamicResource DynamicError}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Email}" FontSize="11" FontWeight="Bold" 
                                           Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Border>

                <!-- Developer Credit Card -->
                <Border Background="{DynamicResource DynamicCardBg}" CornerRadius="20" 
                        BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1.5" Padding="0" Margin="0,0,0,10">
                    <Grid Margin="20,18,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="70" Height="70" CornerRadius="35" 
                                BorderThickness="3" BorderBrush="{StaticResource AccentGradient}" 
                                VerticalAlignment="Center" Margin="0,0,18,0">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/Avatar.jpg" Stretch="UniformToFill"/>
                            </Border.Background>
                            <Grid>
                                <Border Width="22" Height="22" CornerRadius="11" Background="#22C55E" 
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                        Margin="0,0,-6,-6" BorderThickness="2.5" BorderBrush="{DynamicResource DynamicCardBg}">
                                    <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Info with Animation -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="{DynamicResource MadeWithLove_Part1}" FontSize="11" 
                                           Foreground="{DynamicResource DynamicSubText}"/>
                                <TextBlock x:Name="HeartText" Text="❤" FontSize="11" FontWeight="Bold" 
                                           VerticalAlignment="Center" Margin="4,-2,4,0" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Foreground>
                                        <SolidColorBrush x:Name="HeartBrush" Color="#EF4444"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.25">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CircleEase EasingMode="EaseOut"/>
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1.12">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CircleEase EasingMode="EaseOut"/>
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.25">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CircleEase EasingMode="EaseOut"/>
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1.12">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CircleEase EasingMode="EaseOut"/>
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="HeartBrush" Storyboard.TargetProperty="Color">
                                                        <LinearColorKeyFrame KeyTime="0:0:0" Value="#EF4444"/>
                                                        <EasingColorKeyFrame KeyTime="0:0:0.1" Value="#FCA5A5"/>
                                                        <LinearColorKeyFrame KeyTime="0:0:0.2" Value="#EF4444"/>
                                                        <EasingColorKeyFrame KeyTime="0:0:0.35" Value="#F87171"/>
                                                        <LinearColorKeyFrame KeyTime="0:0:0.45" Value="#EF4444"/>
                                                    </ColorAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource MadeWithLove_Part2}" FontSize="11" 
                                           Foreground="{DynamicResource DynamicSubText}"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource DeveloperName}" FontSize="24" FontWeight="Black" 
                                       Foreground="{DynamicResource DynamicAccent}" Margin="0,0,0,4"/>

                            <Border Background="#100EA5E9" Padding="10,4" CornerRadius="12" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource LeadDesigner}" FontSize="10" 
                                               Foreground="{DynamicResource DynamicAccent}" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Tag and Diagoo1 Signature -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="{DynamicResource DynamicHoverBg}" Padding="8,4" CornerRadius="8" Margin="0,0,0,8">
                                <TextBlock Text="Diagoo1" FontSize="9" FontWeight="Bold" 
                                           Foreground="{DynamicResource DynamicSubText}"/>
                            </Border>
                            <TextBlock Text="&lt;/&gt;" FontSize="20" FontWeight="Thin" 
                                       Foreground="{DynamicResource DynamicAccent}" Opacity="0.15" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================== FOOTER SECTION ================== -->
            <Border Grid.Row="2" Background="{DynamicResource DynamicCardBg}" CornerRadius="0,0,16,16" 
                    Padding="20,12" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Left Side - Status -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Activated}" FontSize="10" FontWeight="Bold" 
                                   Foreground="{DynamicResource DynamicMainText}"/>
                        <TextBlock Text="{DynamicResource AllRightsReserved}" FontSize="10" 
                                   Foreground="{DynamicResource DynamicSubText}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- Right Side - OK Button -->
                    <Button Content="{DynamicResource OK}" HorizontalAlignment="Right" 
                            Style="{StaticResource ModernBtn}" Click="btnClose_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>