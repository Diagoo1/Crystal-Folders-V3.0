<Window x:Class="CrystalFolders.Tray.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayMenu" Width="200" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FlowDirection="{DynamicResource AppFlowDirection}"
        FontFamily="Segoe UI"
        Deactivated="Window_Deactivated">

    <Window.Resources>

        <!-- ================== TRAY MENU ITEM STYLE ================== -->
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="4,2"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="ContentGrid" Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Icon"
                                           Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <ContentPresenter x:Name="Text"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Icon"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="3" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Text"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Icon"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Text"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== EXIT ITEM STYLE ================== -->
        <Style x:Key="TrayMenuItemExit" TargetType="Button" BasedOn="{StaticResource TrayMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="4,2">
                            <Grid Margin="10,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DynamicError}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== SEPARATOR STYLE ================== -->
        <Style x:Key="TrayMenuSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

    </Window.Resources>

    <!-- ================== MAIN LAYOUT ================== -->
    <Border Background="{DynamicResource DynamicSidebarBg}"
            CornerRadius="14"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <StackPanel Margin="2">

            <!-- Header Section -->
            <StackPanel Orientation="Horizontal"
                        Margin="14,12,14,10"
                        FlowDirection="LeftToRight">
                <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                    <Image Source="pack://application:,,,/Assets/Logo.png"
                           Width="32" Height="32" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="{DynamicResource AppTitle}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource DynamicMainText}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Separator Style="{StaticResource TrayMenuSeparator}"/>

            <!-- Navigation Section -->
            <Button Content="{DynamicResource TrayOpen}" Tag="&#xE80F;" Style="{StaticResource TrayMenuItem}" Click="Open_Click"/>
            <Button Content="{DynamicResource TrayIconConverter}" Tag="&#xE71B;" Style="{StaticResource TrayMenuItem}" Click="Converter_Click"/>

            <Separator Style="{StaticResource TrayMenuSeparator}"/>

            <!-- System Section -->
            <Button Content="{DynamicResource Settings}" Tag="&#xE713;" Style="{StaticResource TrayMenuItem}" Click="Settings_Click"/>
            <Button Content="{DynamicResource AboutApp}" Tag="&#xE946;" Style="{StaticResource TrayMenuItem}" Click="About_Click"/>

            <Separator Style="{StaticResource TrayMenuSeparator}"/>

            <!-- Exit Section -->
            <Button Content="{DynamicResource TrayExit}" Tag="&#xE711;" Style="{StaticResource TrayMenuItemExit}" Click="Exit_Click"/>

        </StackPanel>
    </Border>
</Window>